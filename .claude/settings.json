{
  "permissions": {
    "allow": [
      "Bash(ops/scripts/board-status.sh)",
      "Bash(./ops/scripts/board-status.sh)",
      "Bash(bash ops/scripts/board-status.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/externer-code.sh"
          }
        ]
      }
    ]
  }
}
